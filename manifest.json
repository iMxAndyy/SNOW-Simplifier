{
  "manifest_version": 3,
  "name": "ServiceNow Simplifier Dashboard",
  "version": "1.1.1",
  "description": "Auto-refreshing ticket queue, simplified UI and personal tools for ServiceNow",
  "content_scripts": [
    {
      "matches": [
        "https://wluk.service-now.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://wluk.service-now.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "content.js"
  }
}
